# Copy to .env and fill in. .env is never committed.
APIFY_TOKEN=          # job pulls from LinkedIn + Seek (apify.com, free plan is enough)
NOTION_TOKEN=         # your Notion integration secret (notion.so/my-integrations)
NOTION_DATABASE_ID=   # the tracker database, shared with that integration
ANTHROPIC_API_KEY=    # company research briefs (console.anthropic.com)
